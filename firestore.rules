rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // API-key vault and user settings. The owner reads and writes their own.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Billing state. READ-ONLY to the owner, so the app can show "3 days left"
    // and "past due" without a round trip — and WRITABLE BY NOBODY.
    //
    // Every field here (plan, status, trialStartedAt, currentPeriodEnd) is
    // written only by the Cloud Functions, which use the Admin SDK and bypass
    // these rules entirely. A client-writable `plan` field is not a paywall,
    // it is a suggestion: anyone with the Firebase config — which ships in the
    // web bundle, because web API keys are not secrets — could set their own
    // to 'pro' from the browser console.
    //
    // trialStartedAt in particular MUST be server-written. A client-supplied
    // trial start resets every time the user changes their system date, and a
    // client-created document would let one account restart the trial forever.
    match /accounts/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
