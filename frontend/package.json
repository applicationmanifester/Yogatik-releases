{
  "name": "yogatik",
  "private": true,
  "version": "3.9.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --configLoader runner",
    "build": "node ./node_modules/vite/bin/vite.js --configLoader runner build",
    "preview": "node ./node_modules/vite/bin/vite.js --configLoader runner preview",
    "test": "node ./scripts/run-vitest.mjs",
    "test:watch": "node ./scripts/run-vitest.mjs --watch",
    "lint": "node ./node_modules/eslint/bin/eslint.js src",
    "build:electron": "node ./node_modules/vite/bin/vite.js --configLoader runner build --base=./ --outDir dist-electron",
    "electron:dev": "electron .",
    "electron:build": "npm run build:electron && electron-builder --win nsis --publish never",
    "electron:build:all": "npm run build:electron && electron-builder -mwl --publish never",
    "electron:build:mac": "npm run build:electron && electron-builder --mac --publish never",
    "electron:build:linux": "npm run build:electron && electron-builder --linux --publish never"
  },
  "dependencies": {
    "dexie": "^4.0.0",
    "firebase": "^12.17.1",
    "lucide-react": "^0.460.0",
    "mp4-muxer": "^5.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.3.9",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "app.yogatik.desktop",
    "productName": "Yogatik",
    "directories": {
      "output": "release-electron"
    },
    "files": [
      "dist-electron/**/*",
      "electron/**/*",
      "bin/**/*"
    ],
    "extraResources": [
      {
        "from": "bin/search-sidecar",
        "to": "search-sidecar",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "applicationmanifester",
        "repo": "Yogatik-releases"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "artifactName": "Yogatik-Setup.exe"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "electron/icon.png",
      "maintainer": "applicationmanifester",
      "artifactName": "Yogatik.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "electron/icon.png",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Yogatik.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/applicationmanifester/Yogatik.git"
  },
  "description": "Yogatik — private, browser-native AI assistant with local file tools.",
  "author": "applicationmanifester"
}
