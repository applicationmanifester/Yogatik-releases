# Yogatik Studio & Web Environment Template
# Copy this file to .env or configure keys directly within the app's Settings modal.

# Optional Cloudflare CORS Proxy URL (for bypassing CORS on direct browser LLM calls)
VITE_CORS_PROXY=https://yogatik-cors-proxy.your-subdomain.workers.dev

# Optional Default Provider Configuration
# VITE_DEFAULT_PROVIDER=groq
# VITE_DEFAULT_MODEL=llama-3.3-70b-versatile

# Note: API keys are securely stored in the OS Encrypted Credential Vault (Windows DPAPI / safeStorage)
# and never saved in plaintext source files or committed to Git.
