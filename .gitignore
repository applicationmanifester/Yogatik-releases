# Node / Dependencies
node_modules/
dist/
.vite/

# Python / Environments
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
searxng-venv/
searxng-src/
data/
chroma_data/

# Environment Variables & Secrets
.env
.env.*
*.env
*.env.*
*.env.local
*.pem
*.key
# Firebase Functions emulator secret store. NOT covered by the .env patterns
# above, and it is where the Razorpay key secret lives locally.
.secret.local
functions/.secret.local
# Real provider ids for the hosted checkout page. The .example file is the one
# that is committed.
frontend/public/checkout-config.json
# ...and the templates MUST stay tracked: `.env.*` above swallows them, and a
# template nobody can see is a setup step nobody knows about.
!functions/.env.example
!**/*.example.json
*service-account*.json
*credentials*.json

# OS / Editor junk
.DS_Store
Thumbs.db
.idea/
.vscode/

# Vitest / Vite timestamps
*.timestamp-*.mjs

# Electron build outputs — Never track build artefacts.
terminal/dist-electron/
terminal/dist-electron-fresh/
**/win-unpacked/
**/release-electron/
**/release-studio/
**/release-personal/
frontend/dist-electron/
yogatik-browser/release/
*.exe
*.blockmap
*.tsbuildinfo
*.log
*.tmp
*.bak
.firebase/
.claude/worktrees/

# Licence signing key — the private half must NEVER be committed.
# It lives in Firebase secrets (functions:secrets:set LICENSE_PRIVATE_KEY).
functions/.keys/
