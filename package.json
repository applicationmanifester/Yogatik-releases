{
  "name": "my-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm run dev --workspace=apps/desktop-electron",
    "dev:web": "npm run dev --workspace=apps/web-app",
    "build:desktop": "npm run build --workspace=apps/desktop-electron",
    "build:web": "npm run build --workspace=apps/web-app",
    "build:all": "npm run build:desktop && npm run build:web",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}