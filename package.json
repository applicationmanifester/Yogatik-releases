{
  "name": "yogatik-monorepo",
  "version": "10.7.0",
  "private": true,
  "description": "Yogatik Studio — Standalone Unrestricted AI Agentic Assistant & Desktop Environment. The application lives in frontend/ — see CLAUDE.md.",
  "main": "frontend/electron/main.cjs",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "test": "npm --prefix frontend run test",
    "test:watch": "npm --prefix frontend run test:watch",
    "lint": "npm --prefix frontend run lint",
    "e2e": "npm --prefix frontend run e2e",
    "build:electron": "npm --prefix frontend run build:electron",
    "electron:dev": "npm --prefix frontend run electron:dev",
    "electron:build": "npm --prefix frontend run electron:build",
    "install:all": "npm --prefix frontend install",
    "cli": "node frontend/bin/yogatik-cli.mjs",
    "bot": "npm --prefix frontend run bot",
    "bot:telegram": "npm --prefix frontend run bot:telegram"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
