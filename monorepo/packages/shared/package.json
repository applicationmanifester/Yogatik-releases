{
  "name": "@acme/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./api": { "types": "./dist/api.d.ts", "import": "./dist/api.js" },
    "./schemas": { "types": "./dist/schemas.d.ts", "import": "./dist/schemas.js" },
    "./utils": { "types": "./dist/utils.d.ts", "import": "./dist/utils.js" },
    "./constants": { "types": "./dist/constants.d.ts", "import": "./dist/constants.js" },
    "./types": { "types": "./dist/types.d.ts", "import": "./dist/types.js" }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc -b --noEmit false",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": { "zod": "^3.23.8" },
  "devDependencies": {
    "@acme/config": "workspace:*",
    "eslint": "^9.9.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
