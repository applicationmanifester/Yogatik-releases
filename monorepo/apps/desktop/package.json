{
  "name": "@acme/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && electron-builder --config electron-builder.yml",
    "build:unpacked": "tsc -b && vite build && electron-builder --dir --config electron-builder.yml",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src electron",
    "test": "vitest run",
    "clean": "rm -rf dist dist-electron release *.tsbuildinfo"
  },
  "dependencies": {
    "@acme/shared": "workspace:*",
    "@acme/ui": "workspace:*",
    "electron-updater": "^6.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@acme/config": "workspace:*",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.0.1",
    "electron-builder": "^25.0.5",
    "eslint": "^9.9.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.0.5"
  }
}
