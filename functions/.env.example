# Copy to functions/.secret.local for the emulator, and set each one in Secret
# Manager for production:  firebase functions:secrets:set <NAME>
#
# NONE of these may ever appear in frontend/ — the key SECRET in particular is
# what signs and verifies payments. The frontend receives only the key ID, and
# it receives it from createSubscription's response rather than from a build
# variable, so there is no VITE_RAZORPAY_* to leak.

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_MONTHLY=plan_xxxxxxxxxxxxxx
RAZORPAY_PLAN_YEARLY=plan_xxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=

# Paddle (international; leave unset until the account is approved)
PADDLE_WEBHOOK_SECRET=

# Licence signing. The PUBLIC half of this keypair lives in
# frontend/electron/entitlementCore.cjs; the private half must never leave here.
LICENSE_PRIVATE_KEY=
